ource":"","filename":"https://a-us.storyblok.com/f/1000914/1860x1290/f97a5c2c53/top-009_flighit.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"link10":{"id":"e36dff18-19ff-4fc7-ae38-c6f5b3374625","url":"","linktype":"story","fieldtype":"multilink","cached_url":"works/tokyo-disney-resort-app"},"text10":"Tokyo\nDisney\nResort\nApp","image10":{"id":1071137,"alt":"","name":"","focus":"","title":"","source":"","filename":"https://a-us.storyblok.com/f/1000914/2640x1680/b2ae74a16d/top-010_tokyo-disney-resort-app.png","copyright":"","fieldtype":"asset","meta_data":{},"is_external_url":false},"component":"page","subTitle1":"Led the UX/UI design lifecycle at Sotheby’s, integrating user research to drive the strategic roadmap and enhance digital experiences in the luxury market.","subTitle2":"Set a new standard for localized digital experiences with 5M+ downloads and enhanced engagement.","subTitle3":"Drove 200% activation growth and 1M+ downloads, enhancing engagement and loyalty.","subTitle4":"Designed an interactive app for Story of the Forest, enhancing engagement for 8M+ visitors over 8 years.","subTitle5":"As a Senior Product Designer at teamLab, I led the ANA Mileage Club app design, boosting engagement, convenience, and loyalty, with a 200% activation increase and 1M+ downloads.","subTitle6":"As Senior Product Designer for Will TAP, I developed a smart home app for Proud apartments in Japan, achieving 80% adoption with an intuitive interface and advanced convenience features.","subTitle7":"I led the UX/UI design for Shiseido’s Interactive Digital Interface at GINZA SIX, creating an interactive beauty experience that redefined in-store engagement.","subTitle8":"As Lead Product Designer for coe, I crafted its brand and UX/UI, enabling AI-driven human rights risk analysis to empower workers and transform corporate behavior.","subTitle9":"I led the UX/UI design and project management for Flight of Dreams, a 2.5-year aviation exhibition with 4M+ visitors and 3M+ app downloads, redefining the airport experience.","subTitle10":"As the Lead Designer, I integrated Disney’s iconic brand with Japanese user preferences through thoughtful UX/UI design and art direction, achieving over 5M downloads, enhancing user engagement, and setting a new standard for localized digital experiences."},"slug":"home","full_slug":"home","sort_by_date":null,"position":0,"tag_list":[],"is_startpage":false,"parent_id":0,"meta_data":null,"group_id":"50dd9526-047e-44a0-9872-f0fc1400b8b3","first_published_at":"2022-09-28T02:44:03.612Z","release_id":null,"lang":"default","path":null,"alternates":[],"default_full_slug":null,"translated_slugs":null},"cv":1742315186,"rels":[],"links":[]}